{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "node scripts/build-service.mjs incident-reporting",
    "watchPatterns": [
      "/services/incident-reporting/**",
      "/packages/platform/**",
      "/packages/contracts/**",
      "/scripts/migrate.mjs",
      "/package*.json",
      "/tsconfig.base.json"
    ]
  },
  "deploy": {
    "preDeployCommand": "node scripts/migrate.mjs incident-reporting",
    "startCommand": "npm run start -w @vsafe/incident-reporting",
    "healthcheckPath": "/health/ready",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
